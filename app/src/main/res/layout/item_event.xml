<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/medium_blue">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/image_thumbnail"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:src="@drawable/securewatch_logo"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Thumbnail" />

        <TextView
            android:id="@+id/text_event_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/image_thumbnail"
            android:layout_marginStart="12dp"
            android:text="Prioridad Alta"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/text_event_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/text_event_title"
            android:layout_toEndOf="@id/image_thumbnail"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="Sensores activos: 2"
            android:textColor="@color/grey_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/text_event_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:text="12/02 14:05"
            android:textColor="@color/light_gray"
            android:textSize="12sp"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
