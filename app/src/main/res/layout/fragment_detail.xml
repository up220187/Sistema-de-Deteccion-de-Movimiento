<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_blue"
    tools:context="com.example.sistemamovimiento.ui.detail.DetailFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_detail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/medium_blue"
            app:title="Detalle del Evento"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_close" />
    </com.google.android.material.appbar.AppBarLayout>

    <ImageView
        android:id="@+id/image_full_event"
        android:layout_width="370dp"
        android:layout_height="441dp"
        android:contentDescription="Imagen capturada del evento de movimiento"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.461"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayoutDetail"
        app:layout_constraintVertical_bias="0.052" />

    <ProgressBar
        android:id="@+id/progress_bar_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="@+id/image_full_event"
        app:layout_constraintBottom_toBottomOf="@+id/image_full_event"
        app:layout_constraintStart_toStartOf="@+id/image_full_event"
        app:layout_constraintEnd_toEndOf="@+id/image_full_event"/>

    <!-- Título principal (ya tenía Top, está bien) -->
    <TextView
        android:id="@+id/textDet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:text="Detalle de detección"
        android:textColor="#A09595"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_full_event" />

    <!-- FECHA: Lo ponemos debajo del título textDet -->
    <TextView
        android:id="@+id/textFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:text="Fecha de detección:"
        android:textColor="#A09595"
        app:layout_constraintTop_toBottomOf="@+id/textDet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/FechaDet"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <TextView
        android:id="@+id/FechaDet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="DD/MM/AAAA"
        android:textColor="#A09595"
        app:layout_constraintTop_toTopOf="@+id/textFecha"
        app:layout_constraintStart_toEndOf="@+id/textFecha"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- HORA: Lo ponemos debajo de la Fecha -->
    <TextView
        android:id="@+id/textHora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:text="Hora de detección:"
        android:textColor="#A09595"
        app:layout_constraintTop_toBottomOf="@+id/textFecha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/HoraDet"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <TextView
        android:id="@+id/HoraDet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="HH/MM"
        android:textColor="#A09595"
        app:layout_constraintTop_toTopOf="@+id/textHora"
        app:layout_constraintStart_toEndOf="@+id/textHora"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PRESENCIA: Lo ponemos debajo de la Hora -->
    <TextView
        android:id="@+id/textPrecencia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:text="Presencia Detectada:"
        android:textColor="#A09595"
        app:layout_constraintTop_toBottomOf="@+id/textHora"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/PrecenciaDet"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <TextView
        android:id="@+id/PrecenciaDet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Persona/Animal"
        android:textColor="#A09595"
        app:layout_constraintTop_toTopOf="@+id/textPrecencia"
        app:layout_constraintStart_toEndOf="@+id/textPrecencia"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
