<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_blue"
    tools:context="com.example.sistemamovimiento.ui.detail.DetailFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_detail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/medium_blue"
            app:title="Detalle del Evento"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_arrow_back" /> <!-- Asegúrate de tener este icono o usa uno de sistema -->
    </com.google.android.material.appbar.AppBarLayout>

    <!-- IMAGEN DEL EVENTO -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_image"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:layout_margin="20dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/medium_blue"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayoutDetail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/image_full_event"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/securewatch_logo" />

        <!-- ETIQUETA DE HUMANO DETECTADO (Flotando sobre la imagen) -->
        <TextView
            android:id="@+id/chip_human_detected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡HUMANO DETECTADO!"
            android:background="#D50000"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:visibility="gone"
            tools:visibility="visible"/>
    </androidx.cardview.widget.CardView>

    <!-- TÍTULO Y FECHA -->
    <TextView
        android:id="@+id/textDet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prioridad ALTA"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@+id/card_image"
        app:layout_constraintTop_toBottomOf="@+id/card_image"/>

    <TextView
        android:id="@+id/textFechaHora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="01 Ene 2025 • 14:30 hrs"
        android:textColor="#B0BEC5"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/textDet"
        app:layout_constraintTop_toBottomOf="@+id/textDet"/>

    <View
        android:id="@+id/divider_det"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@+id/card_image"
        app:layout_constraintEnd_toEndOf="@+id/card_image"
        app:layout_constraintTop_toBottomOf="@+id/textFechaHora"/>

    <!-- SECCIÓN SENSORES CON CHIPS -->
    <TextView
        android:id="@+id/lbl_sensors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sensores Activados"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@+id/card_image"
        app:layout_constraintTop_toBottomOf="@+id/divider_det"/>

    <!-- CONTENEDOR HORIZONTAL DE CHIPS -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/lbl_sensors"
        app:layout_constraintStart_toStartOf="@+id/card_image"
        app:layout_constraintEnd_toEndOf="@+id/card_image">

        <!-- CHIP IR -->
        <LinearLayout
            android:id="@+id/chip_ir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_sensor_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginEnd="8dp"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="#FF5252"/> <!-- Rojo -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IR"
                android:textColor="#FF5252"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- CHIP PIR -->
        <LinearLayout
            android:id="@+id/chip_pir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_sensor_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginEnd="8dp"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_mylocation"
                app:tint="#4FC3F7"/> <!-- Azul -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PIR"
                android:textColor="#4FC3F7"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- CHIP SOUND -->
        <LinearLayout
            android:id="@+id/chip_sound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_sensor_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="#FFD740"/> <!-- Amarillo -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sonido"
                android:textColor="#FFD740"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Mensaje si no hay sensores -->
    <TextView
        android:id="@+id/txt_no_sensors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sin datos específicos de sensores."
        android:textColor="#90A4AE"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/lbl_sensors"
        app:layout_constraintStart_toStartOf="@+id/lbl_sensors"
        android:layout_marginTop="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
